# ── Anthropic ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Meta (un solo token para WhatsApp + Facebook + Instagram) ──────────────────
META_TOKEN=EAAxxxxxx                      # Token de la App en Meta for Developers
META_VERIFY_TOKEN=elige_un_token_secreto  # El mismo para los 3 webhooks

# WhatsApp
WHATSAPP_PHONE_NUMBER_ID=123456789        # ID del número de WhatsApp Business

# Facebook Messenger
FACEBOOK_PAGE_ID=987654321               # ID de tu página de Facebook

# Instagram DM
INSTAGRAM_ACCOUNT_ID=111222333           # ID de la cuenta de Instagram Business

# ── Go High Level CRM ──────────────────────────────────────────────────────────
GHL_API_KEY=eyJhbGciOiJIUzI1NiIsInR5...  # API Key de GHL (Settings > API Keys)
GHL_LOCATION_ID=abc123xyz                 # ID del sub-account/location
GHL_PIPELINE_ID=pip_xyz123               # ID del pipeline (GET /pipelines en GHL API)

# Stage IDs del pipeline inmobiliario (obtener de GET /pipelines/{id})
GHL_STAGE_NUEVO_LEAD=stage_id_1
GHL_STAGE_CONTACTADO=stage_id_2
GHL_STAGE_CALIFICADO=stage_id_3
GHL_STAGE_CITA_PROPUESTA=stage_id_4
GHL_STAGE_CITA_CONFIRMADA=stage_id_5
GHL_STAGE_VISITA_REALIZADA=stage_id_6
GHL_STAGE_NEGOCIACION=stage_id_7
GHL_STAGE_CERRADO_GANADO=stage_id_8
GHL_STAGE_CERRADO_PERDIDO=stage_id_9

# ── Google Calendar ────────────────────────────────────────────────────────────
GOOGLE_CREDENTIALS_FILE=credentials.json  # Service account JSON descargado de GCP
GOOGLE_CALENDAR_ID=tu_email@gmail.com     # O el ID del calendario específico

# ── Desarrollo A ───────────────────────────────────────────────────────────────
